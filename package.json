{
  "name": "skillbridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "test": "vitest run",
    "check:links": "node scripts/check-links.mjs",
    "check:lessons": "node scripts/check-lessons.mjs",
    "db:setup": "node --env-file-if-exists=.env.local scripts/db-setup.mjs",
    "db:disable-demo": "node --env-file-if-exists=.env.local scripts/disable-demo-users.mjs"
  },
  "dependencies": {
    "next": "14.2.35",
    "next-mdx-remote": "^6.0.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
