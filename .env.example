# ── Database (Neon Postgres) ──────────────────────────────────
# Create a free project at https://neon.tech → copy the pooled
# connection string here. When set, ALL data (users, attempts,
# applications, posted jobs, email outbox) lives in Postgres;
# when empty, the app falls back to .data/*.json (local dev).
# After adding it, run:  npm run db:setup
DATABASE_URL=
# Session-signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start in production without it (min 32 chars).
AUTH_SECRET=

# ── Site ──────────────────────────────────────────────────────
# Canonical URL used in emails, metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ── Demo mode (optional) ──────────────────────────────────────
# Demo accounts (ananya / riya / admin, password skillbridge123) are
# seeded ONLY outside production, or when DEMO_MODE=true.
DEMO_MODE=false
# Shows the "Try the demo" bar on the landing page.
NEXT_PUBLIC_DEMO_MODE=false

# ── Email (Resend) ────────────────────────────────────────────
# 1. Create an account at https://resend.com → API Keys → create key
# 2. Until you verify a domain, Resend can only deliver to YOUR own
#    account email using the default onboarding@resend.dev sender.
# 3. For production: Domains → add your domain → add the DNS records
#    Resend shows → then set EMAIL_FROM to an address on that domain.
# When RESEND_API_KEY is empty, emails land in the outbox table
# (or .data/outbox.json) and are visible in /dev-inbox (dev only).
RESEND_API_KEY=
EMAIL_FROM=SkillBridge <onboarding@resend.dev>
# Where recruiter-review pings go in production.
ADMIN_EMAIL=admin@skillbridge.in
